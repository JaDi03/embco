# Copy to .env.local and fill in. Never commit real values.

# Arc Testnet
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002

# Agent brain (server only). Switching model or vendor is a change here, not in code.
AGENT_PROVIDER=anthropic
AGENT_MODEL=
# Optional: low | medium | high | xhigh | max
AGENT_EFFORT=
ANTHROPIC_API_KEY=

# Agent onchain (server only). RPC is the same variable arc-canteen exports; it may carry a token.
RPC=https://rpc.testnet.arc.network
CAMPAIGNS_ADDRESS=0x73aF5bF164eB25E0c740Ed33cA561d5d6f90F41e
# Temporary local key until the Circle DCW signer lands. Signs the journal and the transactions.
AGENT_PRIVATE_KEY=
