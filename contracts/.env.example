# Copy to .env and fill in. Never commit real values.

# Arc Testnet RPC. With arc-canteen, `. ~/.arc-canteen/env` exports your personal RPC
# and it takes precedence over this file. Without Canteen, use the public endpoint:
RPC=https://rpc.testnet.arc.network

# Deployer key (optional). If empty, pass `--account <keystore>` to forge script instead.
DEPLOYER_PRIVATE_KEY=
