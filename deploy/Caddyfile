# The dashboard, its /rpc doors to the Arc nodes and the hub API. Imported from /etc/caddy/Caddyfile.
{$EMBCO_SITE} {
	encode zstd gzip
	root * /opt/embco/dashboard
	@rpc {
		# /rpc is Arc Testnet, /rpc/mainnet is Arc Mainnet (served once its node is set)
		path /rpc /rpc/mainnet
		method POST
	}
	handle @rpc {
		# the hub passes page and wallet calls to the Arc node, with limits (services/hub/rpc_proxy.py)
		reverse_proxy 127.0.0.1:8090
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	@rpc_other path /rpc /rpc/mainnet
	respond @rpc_other "POST JSON-RPC only" 405
	@private path /test/* /package.json
	respond @private 404
	file_server
	header {
		# No HTTP/3 offer: QUIC over UDP breaks on some networks and antivirus, and the page gains nothing
		-Alt-Svc
		# connect-src: Circle Gateway and the public nodes Circle's Unified Balance Kit uses for the
		# chains where the owner deposits (from the kit's own chain definitions)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://explorer.testnet.arc.io https://gateway-api-testnet.circle.com https://sepolia.base.org https://sepolia-rollup.arbitrum.io https://ethereum-sepolia-rpc.publicnode.com https://api.avax-test.network https://sepolia.optimism.io https://polygon-amoy-bor-rpc.publicnode.com https://polygon-amoy.drpc.org https://sepolia.unichain.org; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
	}
	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json
}
