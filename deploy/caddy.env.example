# Caddy's settings for the dashboard. install.sh copies this file to /etc/caddy/embco.env.

# The dashboard's address: a domain (Caddy gets its HTTPS certificate) or http://localhost
EMBCO_SITE=app.example.com

# The Arc node the dashboard reads through /rpc, as scheme and host, then path. install.sh fills
# both from ARC_TESTNET_RPC_URL, so a key in the node URL stays on the server.
EMBCO_RPC_UPSTREAM=https://rpc.testnet.arc.io
EMBCO_RPC_PATH=/
