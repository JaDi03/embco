# Caddy's settings for the dashboard. Copy to /etc/caddy/embco.env (see docs/server.md).

# The dashboard's address: a domain (Caddy gets its HTTPS certificate) or http://localhost
EMBCO_SITE=app.example.com

# The Arc node the dashboard reads through /rpc, split in two: scheme and host, then the path
# ("/" if it has none). A node URL with a key in its path keeps the key on the server.
EMBCO_RPC_UPSTREAM=https://rpc.testnet.arc.io
EMBCO_RPC_PATH=/
