# The embco.xyz landing page (dashboard/landing/), with the dashboard's shared styles and theme.
# Not part of the install: only the embco.xyz server imports it, with a line in
# /etc/caddy/Caddyfile:  import /opt/embco/deploy/Caddyfile-landing
embco.xyz {
	encode zstd gzip
	root * /opt/embco/dashboard
	@home path /
	rewrite @home /landing/
	@private path /test/* /package.json
	respond @private 404
	file_server
	header {
		# No HTTP/3 offer, as on the dashboard
		-Alt-Svc
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
	}
}
