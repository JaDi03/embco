# The server's settings. install.sh copies this file to /etc/embco/embco.env and asks for the
# values (see docs/server.md). Never commit the filled-in copy.
# Each shop's own settings (its ERPNext, limits, draft mode) come from the dashboard, not from here.

# The Arc Testnet node the shops' agents use
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Circle developer-controlled wallets: the server creates one agent wallet per shop.
# Register the entity secret in the Circle Console first.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# The AI model account the shops' agents use
ANTHROPIC_API_KEY=

# The address people open the dashboard at
EMBCO_PUBLIC_URL=https://app.example.com

# Optional: the Telegram bot (/status, /pause, /stop and messages to the agent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
