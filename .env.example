EMBCO_ERPNEXT_URL=https://your-erpnext.example.com
EMBCO_ERPNEXT_API_KEY=
EMBCO_ERPNEXT_API_SECRET=
# The ERPNext company the agent works for
EMBCO_COMPANY=
# Policy, in the company currency
EMBCO_MAX_PER_PAYMENT=
EMBCO_WEEKLY_BUDGET=
# Optional
# EMBCO_MAX_PRICE_INCREASE=0.15
# EMBCO_JOURNAL_PATH=data/journal.sqlite3
# EMBCO_INTERVAL_MINUTES=15
# Arc Testnet node with its access token (for example, from `arc-canteen rpc-url`). Never commit it.
# ARC_TESTNET_RPC_URL=
# AI helper: plain-language explanations of HOLD and ASK decisions for the owner (off by default)
# EMBCO_EXPLAIN=on
# EMBCO_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
# The agent's paying wallet: Circle developer-controlled wallets (register the entity secret in
# the Circle Console and keep its recovery file outside this folder), then `embco create-wallet`
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# EMBCO_AGENT_WALLET_ID=
# Payments (off by default): pay the planned invoices through the shop contract, in USD only
# EMBCO_PAY=on
# EMBCO_SHOP_ADDRESS=
# The ERPNext account the payments leave from (for example a "USDC Wallet" bank account);
# empty uses ERPNext's default for the company
# EMBCO_ERPNEXT_PAID_FROM=
# Supplier wallets in standard Bank Account rows of this bank, instead of a custom field
# EMBCO_ERPNEXT_WALLET_BANK=USDC on Arc
# Fields your ERP requires on a Payment Entry, as JSON (for example a local payment form)
# EMBCO_ERPNEXT_PAYMENT_EXTRA={"payment_form": "03"}
# Where the agent publishes the wallets waiting for the owner's approval (served to the dashboard)
# EMBCO_APPROVALS_FILE=
# ERPNext accounts whose answer on an invoice counts as the owner's (comma separated)
# EMBCO_OWNER_USERS=
