# Your embco server. Copy this file to .env, fill it in, then run: sudo bash deploy/install.sh
# The install moves .env to /etc/embco/embco.env. Never commit it.
# Each shop's own settings (its ERPNext, limits, draft mode) are set in the dashboard.

# Where people open the dashboard: your domain, for example app.example.com
EMBCO_SITE=

# An Arc Testnet node URL
ARC_TESTNET_RPC_URL=

# Circle developer-controlled wallets: the server creates one agent wallet per shop.
# Register the entity secret in the Circle Console first.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# The AI model account the shops' agents use
ANTHROPIC_API_KEY=

# Optional: a Telegram bot from @BotFather, for /status, /pause, /stop and messages to the agent
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
