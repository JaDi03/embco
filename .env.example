# Copy this file to .env and fill it in. Never commit .env.

# ERPNext: its address and the keys of the agent's user
EMBCO_ERPNEXT_URL=https://your-erpnext.example.com
EMBCO_ERPNEXT_API_KEY=
EMBCO_ERPNEXT_API_SECRET=
# The company, as written in ERPNext
EMBCO_COMPANY=
# The bank that holds the supplier wallets as Bank Accounts
EMBCO_ERPNEXT_WALLET_BANK=USDC on Arc

# Limits, in the company currency
EMBCO_MAX_PER_PAYMENT=
EMBCO_WEEKLY_BUDGET=

# The shop's offset from UTC, for the daily round and payment dates (for example -06:00)
EMBCO_UTC_OFFSET=

# The AI model that decides what is paid and when
ANTHROPIC_API_KEY=

# The agent's wallet, with Circle developer-controlled wallets: register the entity secret in
# the Circle Console, run `embco create-wallet` once, and paste the wallet id it prints
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
EMBCO_AGENT_WALLET_ID=

# Payments: the shop contract you created in the dashboard, and an Arc Testnet node
EMBCO_SHOP_ADDRESS=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Testnet: each payment stays in ERPNext as a draft marked TESTNET, so test USDC never closes a
# real invoice
EMBCO_ERPNEXT_DRAFT_PAYMENTS=on
# Turn on once everything above is filled in
EMBCO_PAY=off
