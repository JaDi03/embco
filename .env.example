# Your embco server. Copy this file to .env, fill it in, then run: sudo bash deploy/install.sh
# The install moves .env to /etc/embco/embco.env. Never commit it.
# Each shop's own settings (its ERPNext, limits, draft mode) are set in the dashboard.

# Where people open the dashboard: your domain, for example app.example.com
EMBCO_SITE=

# An Arc Testnet node URL
ARC_TESTNET_RPC_URL=

# Optional node overrides for automatic verification of ShopFunding contracts.
# Without these, the worker uses the public Base Sepolia and Ethereum Sepolia nodes.
BASE_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=

# Circle developer-controlled wallets: the server creates one agent wallet per shop.
# Register the entity secret in the Circle Console first. These are the testnet key and secret.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional: Arc Mainnet, for shops that pay in real USDC. Set all three or none.
# The Circle key is a mainnet key (LIVE_API_KEY:...) with its own registered entity secret;
# Circle Gas Station pays the agents' gas and bills this Circle account.
ARC_MAINNET_RPC_URL=
CIRCLE_MAINNET_API_KEY=
CIRCLE_MAINNET_ENTITY_SECRET=

# The AI model account the shops' agents use
ANTHROPIC_API_KEY=

# Optional: a Telegram bot from @BotFather, for /status, /pause, /stop and messages to the agent
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: your own Telegram chat id; the bot tells it about every new shop that connects
EMBCO_OPERATOR_TELEGRAM_CHAT=

# Optional: how many shops may be connected at once (default 20); known shops always reconnect
EMBCO_MAX_SHOPS=
